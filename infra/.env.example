# GamePanel Infrastructure Environment Variables
# Copy this file to .env and customize for your environment.
# For production, run ./gen-env.sh (interactive) or ./gen-env.sh --silent to
# generate a complete .env with random secrets; this file documents every
# variable the compose stack and the forge-api / beacon applications read.

# =============================================================================
# RELEASE / IMAGE TAG (required — compose.yml pins images to ${TAG})
# =============================================================================
# gen-env.sh defaults this to the nearest git tag, or "dev" outside a checkout.
TAG=dev

# Optional per-service image overrides (defaults derive from TAG):
# API_IMAGE=ghcr.io/gamepanel/forge-api:${TAG}
# WEB_IMAGE=ghcr.io/gamepanel/forge-web:${TAG}
# DAEMON_IMAGE=ghcr.io/gamepanel/beacon:${TAG}

# =============================================================================
# PANEL CONFIGURATION
# =============================================================================
PANEL_DOMAIN=panel.example.com
PANEL_URL=https://${PANEL_DOMAIN}
API_DOMAIN=api.${PANEL_DOMAIN}

# =============================================================================
# DATABASE (required)
# =============================================================================
POSTGRES_DB=gamepanel
POSTGRES_USER=gamepanel
POSTGRES_PASSWORD=change_me_please
# Used by forge-api (and passed to postgres/backup/exporter by compose).
DATABASE_URL=postgres://gamepanel:change_me_please@postgres:5432/gamepanel?sslmode=require
# Local backup destination on the host (compose mounts this directory).
POSTGRES_BACKUP_HOST_DIR=/var/backups/gamepanel/postgres
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_RETENTION_DAYS=14
# Published host port in compose.override.yml (development only).
DB_PORT=5432

# =============================================================================
# REDIS (required)
# =============================================================================
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change_me_please
# Published host port in compose.override.yml (development only).
REDIS_PORT=6379

# =============================================================================
# FORGE API (required)
# =============================================================================
API_ADDR=:8080
API_AUTH_SECRET=generate_a_strong_secret_here
APP_KEY=generate_a_strong_secret_here
APP_ENV=production
APP_VERSION=0.1.0
API_SEED_DEMO=false
API_INTERNAL_URL=http://api:8080
MIGRATIONS_DIR=/migrations
LANGS_DIR=lang
BATCH2_MIGRATIONS_DIR=/batch2-migrations
# Database connection pool (optional).
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=3600
# Load balancer port range for game servers (optional).
LOAD_BALANCER_ENABLED=false
LOAD_BALANCER_BIND_HOST=
LOAD_BALANCER_PORT_MIN=30000
LOAD_BALANCER_PORT_MAX=30100
# Caddy admin API used by the API traffic manager (optional).
# CADDY_ADMIN_ADDR=caddy:2019
# CADDY_ADMIN_TOKEN=generate_a_strong_secret_here

# =============================================================================
# FORGE MASTER KEY (required — exactly 32 bytes base64; loss = permanent data
# loss for all encrypted records)
# =============================================================================
FORGE_MASTER_KEY=generate_a_32_byte_base64_key_here
FORGE_MASTER_KEY_ID=primary
FORGE_PREVIOUS_MASTER_KEYS=
FORGE_ALLOW_EPHEMERAL_MASTER_KEY=false

# =============================================================================
# DAEMON / BEACON (required)
# =============================================================================
DAEMON_NODE_ID=replace_with_panel_node_uuid
DAEMON_NODE_TOKEN=replace_with_panel_issued_id.secret
DAEMON_SFTP_HOST_KEY_PASSPHRASE=replace_with_a_separate_32_byte_secret
# Base64 Ed25519 public key used to verify signed remote/self-upgrade metadata.
DAEMON_UPGRADE_PUBLIC_KEY=replace_with_release_signing_public_key
DAEMON_ADDR=:9090
DAEMON_SFTP_ADDR=:2022
DAEMON_SFTP_BIND_ADDR=0.0.0.0:2022
DAEMON_DATA_DIR=/srv/game-panel/servers
DAEMON_BACKUP_DIR=/srv/game-panel/servers/.beacon/backups
BEACON_DATABASE_PATH=/srv/game-panel/servers/.beacon/beacon.db
# Host directory mounted into the daemon at ${DAEMON_DATA_DIR}.
GAME_SERVERS_HOST_DIR=/srv/game-panel/servers
DAEMON_ALLOW_MOCK_RUNTIME=false
DAEMON_ALLOW_INSECURE_NO_AUTH=false
# Reachable from every beacon node (HTTPS required in production).
PANEL_API_URL=https://${PANEL_DOMAIN}/api/v1
BEACON_BASE_URL=http://127.0.0.1:9090

# =============================================================================
# METRICS (required — bearer token for /api/v1/metrics)
# =============================================================================
METRICS_TOKEN=replace_with_a_random_32_byte_secret
# File mounted into prometheus; gen-env.sh writes it from METRICS_TOKEN.
METRICS_TOKEN_FILE=./.metrics-token

# =============================================================================
# MONITORING (Grafana admin account)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_please

# =============================================================================
# ALERTMANAGER (optional)
# =============================================================================
ALERTMANAGER_SMTP_HOST=
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASS=
ALERTMANAGER_SMTP_FROM=noreply@${PANEL_DOMAIN}
ALERTMANAGER_ADMIN_EMAIL=
ALERTMANAGER_WEBHOOK_URL=

# =============================================================================
# BACKUP (optional — local or S3)
# =============================================================================
BACKUP_ADAPTER=local
# S3_BUCKET=my-game-panel-backups
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_PREFIX=panel/
# S3_USE_PATH_STYLE=true
# S3_BACKUP_BUCKET=my-game-panel-backups
# S3_BACKUP_REGION=us-east-1
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=
# S3_BACKUP_PREFIX=postgres

# =============================================================================
# EMAIL / SMTP (optional)
# =============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@${PANEL_DOMAIN}
MAIL_FROM_NAME=GamePanel

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=text
LOG_OUTPUT=stdout
LOG_DRIVER=json-file
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5

# =============================================================================
# SOKETI / WEBSOCKET (optional — requires compose.realtime.yml)
# =============================================================================
SOKETI_APP_ID=gamepanel
SOKETI_APP_KEY=replace_me
SOKETI_APP_SECRET=replace_me
SOKETI_METRICS_PORT=9601
# SOKETI_BIND_ADDR=127.0.0.1

# =============================================================================
# TLS / ACME (required for compose.tls.yml)
# =============================================================================
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_CERTIFICATE_RESOLVER=letsencrypt

# =============================================================================
# CADDY (production — compose.production.yml port bindings)
# =============================================================================
CADDY_HTTP_BIND=80
CADDY_HTTPS_BIND=443
CADDY_ADMIN_PORT=2019

# =============================================================================
# OPTIONAL: AWS AUTO-SCALING (beacon nodes)
# =============================================================================
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SUBNET_ID=
# AWS_SECURITY_GROUP_IDS=sg-0123456789abcdef0
# AWS_IAM_INSTANCE_PROFILE=gamepanel-beacon

# =============================================================================
# OPTIONAL: OTHER FORGE API SETTINGS
# =============================================================================
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAME_SITE=lax
# API_CORS_ALLOWED_ORIGINS=https://${PANEL_DOMAIN}
# API_WS_ALLOWED_ORIGINS=
# ADMIN_IP_ALLOW=
# ADMIN_IP_DENY=
# API_IP_ALLOW=
# API_IP_DENY=
# GIT_SSH_KNOWN_HOSTS=
