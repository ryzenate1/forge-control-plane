# GamePanel local development defaults
# IMPORTANT: Replace all values with real secrets before production use.

APP_ENV=development
# Application secret key used for session signing and encryption
APP_KEY=CHANGE_ME
# Cipher algorithm for APP_KEY encryption
APP_CIPHER=AES-256-GCM

# Panel URL (publicly reachable base URL for email links, etc.)
PANEL_URL=http://localhost:3000

# API
API_ADDR=:8080
API_AUTH_SECRET=replace_with_a_random_32_byte_secret
API_DEMO_MODE=false
# Seeds demo admin/node on first startup (development/local/test only)
API_SEED_DEMO=false
# Set to true in production to enforce secure cookies over HTTPS
SESSION_COOKIE_SECURE=false
DATABASE_URL=postgres://gamepanel:gamepanel@localhost:5432/gamepanel?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=CHANGE_ME
MIGRATIONS_DIR=forge/api/migrations
# Panel-issued node credential in <id>.<secret> form. Generate locally in dev
# (scripts/dev/start-dev.sh does this automatically) — never ship a literal.
DAEMON_NODE_TOKEN=replace_with_panel_issued_id.secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SFTP_HOST=127.0.0.1
NEXT_PUBLIC_SFTP_PORT=2222
NEXT_PUBLIC_SFTP_USER=game

# Daemon / Beacon
DAEMON_ADDR=:9090
DAEMON_DATA_DIR=/srv/game-panel/servers
DAEMON_NODE_ID=22222222-2222-2222-2222-222222222222
PANEL_API_URL=http://localhost:8080/api/v1
# Set to true to allow daemon auth without a valid DAEMON_NODE_TOKEN (development only)
DAEMON_ALLOW_INSECURE_NO_AUTH=false
# Set to true to use a mock runtime that does not require Docker (development only)
DAEMON_ALLOW_MOCK_RUNTIME=false
METRICS_TOKEN=replace_with_a_random_32_byte_secret

# Encryption at Rest (Required when DATABASE_URL is set)
# Generate a 32-byte key, then encode as strict base64 or 64 hex characters.
FORGE_MASTER_KEY=
FORGE_MASTER_KEY_ID=primary
# Development-only escape hatch: allows starting with a random ephemeral key if true
FORGE_ALLOW_EPHEMERAL_MASTER_KEY=false

# Grafana (optional, for monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# S3-compatible backup storage (optional)
# S3_BUCKET=my-game-panel-backups
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PREFIX=panel/
# S3_USE_PATH_STYLE=true

# Integrated L4 load balancer (optional)
# Set to true to enable the built-in load balancer (gen-env.sh/install.sh default it to true)
# LOAD_BALANCER_ENABLED=true
# LOAD_BALANCER_PORT_MIN=30000
# LOAD_BALANCER_PORT_MAX=30100

# AWS EC2 provisioning (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_AMI_ID=
# AWS_INSTANCE_TYPE=t3.medium
