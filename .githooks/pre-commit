#!/bin/sh
# Pre-commit guard: a committed tree must compile and must never carry
# unresolved conflict markers. HEAD once shipped both failures
# (bce7085: non-compiling packages plus `git stash pop` markers left inside
# forge/api/internal/store/store.go and forge/web/components/ui/primitives.tsx),
# which is what this exists to prevent.
#
# Emergency bypass: FORGE_PRECOMMIT_SKIP=1 git commit ... (prints a warning).

set -eu

if [ "${FORGE_PRECOMMIT_SKIP:-}" = "1" ]; then
	echo "pre-commit: FORGE_PRECOMMIT_SKIP=1 set — checks NOT run. The tree is unverified." >&2
	exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# --- 1. Conflict markers -------------------------------------------------
marker_failed=0
for f in $staged; do
	# Read the staged blob, not the working file: the index is what gets
	# committed, and a working-tree edit may already differ from it.
	if git show ":$f" 2>/dev/null | grep -qE '^(<<<<<<< |={7}$|>>>>>>> )'; then
		echo "pre-commit: unresolved conflict marker in $f" >&2
		marker_failed=1
	fi
done
if [ "$marker_failed" -ne 0 ]; then
	cat >&2 <<-EOF
		pre-commit: refusing to commit a file that still contains conflict markers.
		  Resolve the conflict, then re-stage the file.
	EOF
	exit 1
fi

# --- 2. Go build --------------------------------------------------------
go_bin=""
if command -v go >/dev/null 2>&1; then
	go_bin=$(command -v go)
elif [ -x /opt/homebrew/bin/go ]; then
	go_bin=/opt/homebrew/bin/go
fi
if [ -z "$go_bin" ]; then
	# Fail closed: no toolchain means no proof it compiles, and silence here
	# would let the next broken tree through exactly as before.
	echo "pre-commit: no Go toolchain found on PATH or /opt/homebrew/bin — cannot verify the build." >&2
	echo "pre-commit: install Go, or use FORGE_PRECOMMIT_SKIP=1 to commit knowingly." >&2
	exit 1
fi

root=$(git rev-parse --show-toplevel)
for mod in forge/api beacon; do
	echo "$staged" | grep -q "^$mod/.*\.go$" || continue
	printf 'pre-commit: go build ./%s\n' "$mod"
	if ! (cd "$root/$mod" && "$go_bin" build ./... ); then
		echo "pre-commit: refusing to commit — $mod does not build." >&2
		exit 1
	fi
done

exit 0
