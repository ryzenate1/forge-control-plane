{
  "name": "forge-gamepanel",
  "private": true,
  "version": "0.1.0",
  "description": "Forge Control Plane — game server orchestration platform.",
  "scripts": {
    "dev:start": "./scripts/dev/start-dev.sh",
    "dev:stop": "./scripts/dev/stop-dev.sh",
    "dev:status": "./scripts/diagnostics/status.sh",
    "dev:logs": "./scripts/diagnostics/logs.sh",
    "dev": "npm --workspace @forge/web run dev",
    "build:packages": "npm --workspace @forge/shared-types run build && npm --workspace @forge/sdk run build && npm --workspace @forge/ui run build && npm --workspace @forge/game-templates run build",
    "build": "npm --workspace @forge/web run build",
    "lint": "npm --workspace @forge/web run lint",
    "typecheck": "npm run build:packages && npm --workspace @forge/web run typecheck",
    "test": "npm --workspace @forge/web test"
  },
  "workspaces": [
    "forge/web",
    "packages/*"
  ],
  "overrides": {
    "dompurify": "$dompurify",
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "next": {
      "postcss": "$postcss",
      "sharp": "$sharp"
    },
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "resolutions": {
    "dompurify": "3.4.16",
    "postcss": "8.5.28",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "dompurify": "3.4.16",
    "postcss": "8.5.28",
    "sharp": "0.35.5"
  }
}
