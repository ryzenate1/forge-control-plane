APP_ENV=development
API_ADDR=:8080
API_AUTH_SECRET=replace_with_a_random_32_byte_secret
DATABASE_URL=postgres://gamepanel:gamepanel@localhost:5432/gamepanel?sslmode=disable
REDIS_ADDR=localhost:6379
# Panel-issued node credential in <id>.<secret> form. Generate locally in dev —
# never ship a literal.
DAEMON_NODE_TOKEN=replace_with_panel_issued_id.secret
API_DEMO_MODE=false

# Encryption at rest (required when DATABASE_URL is set)
# Generate a 32-byte key, then encode as strict base64 or 64 hex characters.
FORGE_MASTER_KEY=
FORGE_MASTER_KEY_ID=primary
# Comma-separated key-id=encoded-key entries used during rotation.
FORGE_PREVIOUS_MASTER_KEYS=
# Development only; explicitly accepts unrecoverable ephemeral encryption.
FORGE_ALLOW_EPHEMERAL_MASTER_KEY=false

# CORS: comma-separated list of allowed origins (e.g. http://localhost:3000,https://panel.example.com)
# Supports wildcard "*" to allow any origin (not recommended with credentials).
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
