"use client";

/**
 * Admin Overview — the at-a-glance state of the control plane.
 *
 * This page answers three questions in order, and nothing else:
 *
 *   1. Is anything wrong right now?           (platform verdict + issues)
 *   2. What is the fleet, and what is it doing? (inventory + live telemetry)
 *   3. What has capacity been committed to?    (configured vs allocated)
 *
 * Everything on screen is traceable to a named source, and every source's
 * freshness is shown. Three classes of number are kept visually and verbally
 * distinct because confusing them is the easiest way to mislead an operator:
 *
 *   live       — reported by a host agent, with an observation time
 *   configured — capacity an operator entered on a node
 *   allocated  — quota committed to workloads
 *
 * A number that was not reported renders as an em dash with a reason. There
 * are no synthetic series, no static deltas and no placeholder hostnames on
 * this page; if a value is not in the API response, it is not on the screen.
 */

import React, { useMemo } from "react";
import Link from "next/link";
import { Gauge, Layers, Server } from "lucide-react";

import {
  AdminPageHeader,
  AdminPageLayout,
  AdminSection,
  Btn,
  Pill,
} from "@/components/admin/admin-ui";
import {
  ActivityFeedPanel,
  ControlPlaneChecksPanel,
  NodePopulationPanel,
  PlatformStatusBanner,
  derivePlatformVerdict,
} from "@/components/admin/operational-panels";
import {
  AggregateTile,
  DataState,
  MetricTile,
  NodeTelemetryTable,
  PanelCard,
  SourceRibbon,
  type NamedSource,
} from "@/components/admin/telemetry-ui";
import {
  REFRESH,
  allocatedQuota,
  configuredCapacity,
  countLabel,
  fleetAverage,
  indexLatestByNode,
  mbLabel,
  percentLabel,
  sourceState,
  useActivityQuery,
  useAdminOperationalRefresh,
  useHealthQuery,
  useLatestNodeMetricsQuery,
  useNodesQuery,
  useRefreshOnVisible,
  useServersQuery,
} from "@/lib/admin/telemetry";

const ACTIVITY_LIMIT = 8;

export default function AdminOverview() {
  useRefreshOnVisible();
  const refresh = useAdminOperationalRefresh();

  const nodesQuery = useNodesQuery();
  const serversQuery = useServersQuery();
  const healthQuery = useHealthQuery();
  const telemetryQuery = useLatestNodeMetricsQuery();
  const activityQuery = useActivityQuery(ACTIVITY_LIMIT);

  const nodesState = sourceState(nodesQuery, REFRESH.inventory);
  const serversState = sourceState(serversQuery, REFRESH.inventory);
  const healthState = sourceState(healthQuery, REFRESH.health);
  const telemetryState = sourceState(telemetryQuery, REFRESH.telemetry);
  const activityState = sourceState(activityQuery, REFRESH.activity);

  const nodes = nodesQuery.data;
  const servers = serversQuery.data;

  const latestByNode = useMemo(() => indexLatestByNode(telemetryQuery.data), [telemetryQuery.data]);

  const verdict = useMemo(
    () => derivePlatformVerdict({ healthState, report: healthQuery.data, nodesState, nodes }),
    [healthState, healthQuery.data, nodesState, nodes],
  );

  const sources: NamedSource[] = [
    { label: "Nodes", state: nodesState },
    { label: "Servers", state: serversState },
    { label: "Diagnostics", state: healthState },
    { label: "Host telemetry", state: telemetryState },
  ];

  const busy = [nodesQuery, serversQuery, healthQuery, telemetryQuery, activityQuery].some(
    (query) => query.isFetching,
  );

  return (
    <AdminPageLayout>
      <AdminPageHeader
        action={
          <div className="flex items-center gap-2">
            <Btn loading={busy} onClick={refresh} size="sm" tone="ghost">
              Refresh
            </Btn>
            <Link href="/admin/monitoring">
              <Btn size="sm" tone="subtle">
                Monitoring
              </Btn>
            </Link>
          </div>
        }
        description="Live control-plane state, fleet inventory and committed capacity."
        // The shared header renders a hardcoded "Live · updated just now"
        // badge; this page reports each source's real read time instead.
        hideLiveBadge
        title="Overview"
      />

      <SourceRibbon sources={sources} />

      <PlatformStatusBanner
        action={
          <Link href="/admin/health">
            <Btn size="sm" tone="subtle">
              View health
            </Btn>
          </Link>
        }
        verdict={verdict}
      />

      <FleetSection
        latestByNode={latestByNode}
        nodes={nodes}
        nodesState={nodesState}
        servers={servers}
        serversState={serversState}
        telemetryState={telemetryState}
        onRetryNodes={() => void nodesQuery.refetch()}
        onRetryTelemetry={() => void telemetryQuery.refetch()}
      />

      <CapacitySection
        nodes={nodes}
        nodesState={nodesState}
        servers={servers}
        serversState={serversState}
      />

      <AdminSection
        description="Subsystem diagnostics from the control plane, and the most recent recorded events."
        title="Diagnostics and activity"
      >
        <div className="grid gap-4 lg:grid-cols-2">
          <ControlPlaneChecksPanel
            onRetry={() => void healthQuery.refetch()}
            report={healthQuery.data}
            state={healthState}
          />
          <ActivityFeedPanel
            events={activityQuery.data?.events}
            limit={ACTIVITY_LIMIT}
            onRetry={() => void activityQuery.refetch()}
            state={activityState}
          />
        </div>
      </AdminSection>
    </AdminPageLayout>
  );
}

/* ------------------------------------------------------------------ *
 * Fleet — inventory plus what the hosts are actually reporting
 * ------------------------------------------------------------------ */

function FleetSection({
  nodes,
  nodesState,
  servers,
  serversState,
  latestByNode,
  telemetryState,
  onRetryNodes,
  onRetryTelemetry,
}: {
  nodes: Parameters<typeof configuredCapacity>[0] | undefined;
  nodesState: ReturnType<typeof sourceState>;
  servers: Parameters<typeof allocatedQuota>[0] | undefined;
  serversState: ReturnType<typeof sourceState>;
  latestByNode: Map<string, import("@/lib/api/monitoring").NodeMetrics>;
  telemetryState: ReturnType<typeof sourceState>;
  onRetryNodes: () => void;
  onRetryTelemetry: () => void;
}) {
  const nodeList = nodes ?? [];
  const reportingRows = [...latestByNode.values()];

  const cpu = fleetAverage(reportingRows, (row) => row.cpuPercent);
  const memory = fleetAverage(reportingRows, (row) => row.memoryPercent);
  const disk = fleetAverage(reportingRows, (row) => row.diskPercent);

  const telemetryReady = telemetryState.status === "ready";
  const reporting = telemetryReady ? cpu.reporting : 0;
  const coverage = telemetryReady
    ? `${reporting} of ${nodeList.length} ${nodeList.length === 1 ? "node" : "nodes"} reporting`
    : telemetryState.status === "restricted"
      ? "Telemetry is not visible to your account"
      : telemetryState.status === "error"
        ? "Telemetry source unavailable"
        : "Reading telemetry…";

  // The mean is over reporting nodes only. Averaging in non-reporting nodes as
  // zero would make an unreported fleet look idle rather than unknown.
  const meanContext = telemetryReady
    ? `Mean across ${reporting} reporting ${reporting === 1 ? "node" : "nodes"}`
    : coverage;

  return (
    <AdminSection
      description="Inventory counts come from the control plane; utilisation comes from host agents and only covers nodes that have reported."
      title="Fleet"
    >
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <MetricTile
          context={
            nodesState.status === "ready"
              ? `${nodeList.length === 1 ? "node" : "nodes"} registered`
              : "Node inventory unavailable"
          }
          kind="derived"
          label="Nodes"
          missingReason="Node inventory could not be read"
          state={nodesState}
          value={nodesState.status === "ready" ? countLabel(nodeList.length) : undefined}
        />
        <MetricTile
          context={
            serversState.status === "ready"
              ? `${(servers ?? []).length === 1 ? "workload" : "workloads"} defined`
              : "Server inventory unavailable"
          }
          kind="derived"
          label="Workloads"
          missingReason="Server inventory could not be read"
          state={serversState}
          value={serversState.status === "ready" ? countLabel((servers ?? []).length) : undefined}
        />
        <MetricTile
          context={meanContext}
          kind="live"
          label="CPU"
          missingReason={coverage}
          state={telemetryState}
          value={telemetryReady ? percentLabel(cpu.value, 1) : undefined}
        />
        <MetricTile
          context={meanContext}
          kind="live"
          label="Memory"
          missingReason={coverage}
          state={telemetryState}
          value={telemetryReady ? percentLabel(memory.value, 1) : undefined}
        />
        <MetricTile
          context={meanContext}
          kind="live"
          label="Disk"
          missingReason={coverage}
          state={telemetryState}
          value={telemetryReady ? percentLabel(disk.value, 1) : undefined}
        />
      </div>

      <div className="grid gap-4 lg:grid-cols-3">
        <PanelCard
          className="lg:col-span-2"
          description={coverage}
          footer="CPU, memory and disk columns are live host readings. A dash means that node has not reported, not that it is idle."
          icon={Server}
          title="Nodes"
        >
          <DataState
            emptyMessage="No nodes are registered with this control plane yet."
            emptyTitle="No nodes"
            isEmpty={nodeList.length === 0}
            loadingLabel="Reading node inventory…"
            onRetry={onRetryNodes}
            state={nodesState}
          >
            <NodeTelemetryTable
              latestByNode={latestByNode}
              nodes={nodeList}
              telemetryState={telemetryState}
            />
          </DataState>
        </PanelCard>

        <div className="space-y-4">
          <NodePopulationPanel nodes={nodes} onRetry={onRetryNodes} state={nodesState} />
          <PanelCard description="GET /monitoring/nodes/metrics" icon={Gauge} title="Telemetry coverage">
            <DataState
              loadingLabel="Reading telemetry…"
              onRetry={onRetryTelemetry}
              state={telemetryState}
            >
              <p className="text-sm leading-6 text-slate-300">
                {reporting} of {nodeList.length} {nodeList.length === 1 ? "node has" : "nodes have"}{" "}
                reported host metrics.
              </p>
              {nodeList.length > reporting ? (
                <p className="mt-2 text-xs leading-5 text-slate-500">
                  Nodes without a reading are shown as unknown rather than zero. A beacon that is not
                  posting metrics is not the same as a host that is idle.
                </p>
              ) : null}
              {reportingRows.length > 0 ? (
                <div className="mt-3 flex flex-wrap gap-1.5 border-t border-white/[0.06] pt-2.5">
                  <Pill tone="neutral">
                    {reportingRows.reduce((sum, row) => sum + row.containerRunning, 0)} containers running
                  </Pill>
                  <Pill tone="neutral">
                    {reportingRows.reduce((sum, row) => sum + row.containerTotal, 0)} containers total
                  </Pill>
                </div>
              ) : null}
            </DataState>
          </PanelCard>
        </div>
      </div>
    </AdminSection>
  );
}

/* ------------------------------------------------------------------ *
 * Capacity — configured and committed, explicitly not utilisation
 * ------------------------------------------------------------------ */

function CapacitySection({
  nodes,
  nodesState,
  servers,
  serversState,
}: {
  nodes: Parameters<typeof configuredCapacity>[0] | undefined;
  nodesState: ReturnType<typeof sourceState>;
  servers: Parameters<typeof allocatedQuota>[0] | undefined;
  serversState: ReturnType<typeof sourceState>;
}) {
  const capacity = configuredCapacity(nodes ?? []);
  const quota = allocatedQuota(servers ?? []);

  return (
    <AdminSection
      description="Configured capacity is what an operator entered on each node. Allocated quota is what has been committed to workloads. Neither is a measurement of current usage — for that, read the live columns above."
      title="Capacity and allocation"
    >
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <AggregateTile
          format={(value) => mbLabel(value) ?? "—"}
          kind="configured"
          label="Node memory configured"
          noun="nodes"
          state={nodesState}
          total={capacity.memoryMb}
        />
        <AggregateTile
          format={(value) => mbLabel(value) ?? "—"}
          kind="configured"
          label="Node disk configured"
          noun="nodes"
          state={nodesState}
          total={capacity.diskMb}
        />
        <AggregateTile
          format={(value) => String(value)}
          kind="configured"
          label="CPU cores configured"
          noun="nodes"
          state={nodesState}
          total={capacity.cpuCores}
        />
        <AggregateTile
          format={(value) => mbLabel(value) ?? "—"}
          kind="allocated"
          label="Workload memory allocated"
          noun="workloads"
          state={serversState}
          total={quota.memoryMb}
        />
        <AggregateTile
          format={(value) => mbLabel(value) ?? "—"}
          kind="allocated"
          label="Workload disk allocated"
          noun="workloads"
          state={serversState}
          total={quota.diskMb}
        />
        <AggregateTile
          format={(value) => String(value)}
          kind="allocated"
          label="Workload CPU limit"
          noun="workloads"
          state={serversState}
          total={quota.cpuLimit}
        />
      </div>

      <CommitmentNote
        capacityMemory={capacity.memoryMb}
        nodesState={nodesState}
        quotaMemory={quota.memoryMb}
        serversState={serversState}
      />
    </AdminSection>
  );
}

/**
 * Allocation against configured capacity.
 *
 * Only shown when both totals are complete. A ratio computed from partial sums
 * is a misleading percentage, and a misleading percentage is worse than no
 * percentage — so when either side is partial we say why instead.
 */
function CommitmentNote({
  capacityMemory,
  quotaMemory,
  nodesState,
  serversState,
}: {
  capacityMemory: ReturnType<typeof configuredCapacity>["memoryMb"];
  quotaMemory: ReturnType<typeof allocatedQuota>["memoryMb"];
  nodesState: ReturnType<typeof sourceState>;
  serversState: ReturnType<typeof sourceState>;
}) {
  const bothReady = nodesState.status === "ready" && serversState.status === "ready";
  const complete =
    capacityMemory.reported === capacityMemory.total &&
    quotaMemory.reported === quotaMemory.total &&
    capacityMemory.value !== undefined &&
    quotaMemory.value !== undefined &&
    capacityMemory.value > 0;

  if (!bothReady) {
    return (
      <p className="text-xs leading-5 text-slate-500">
        Commitment ratio needs both node and workload inventories; at least one could not be read.
      </p>
    );
  }
  if (!complete) {
    return (
      <p className="text-xs leading-5 text-slate-500">
        Commitment ratio is not shown: {capacityMemory.reported} of {capacityMemory.total} nodes and{" "}
        {quotaMemory.reported} of {quotaMemory.total} workloads report a memory figure, so any percentage
        would be computed from partial totals.
      </p>
    );
  }

  const ratio = (quotaMemory.value! / capacityMemory.value!) * 100;
  return (
    <div className="flex flex-wrap items-center gap-3 rounded-lg border border-white/[0.07] bg-white/[0.012] px-3 py-2.5">
      <Layers size={14} className="text-slate-500" aria-hidden="true" />
      <span className="text-sm text-slate-300">
        <span className="font-mono text-slate-100">{ratio.toFixed(1)}%</span> of configured node memory is
        committed to workload quotas.
      </span>
      <span className="text-xs text-slate-500">
        {mbLabel(quotaMemory.value)} allocated of {mbLabel(capacityMemory.value)} configured — allocation,
        not usage.
      </span>
    </div>
  );
}

/* Named export kept alongside the default so existing imports keep working. */
export { AdminOverview };
