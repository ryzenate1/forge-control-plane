# Server-side only (used by next.config.ts / middleware for internal fetch).
API_INTERNAL_URL=http://127.0.0.1:8080

# Client-side API base. This is inlined into the browser bundle at BUILD time:
# changing it requires a rebuild. When unset, the web client defaults to the
# same-origin "/api/v1" (e.g. served by Caddy in production). For runtime
# reconfiguration without a rebuild, deployers may inject a script tag
# `window.__FORGE_CONFIG__ = { apiBaseUrl: "https://api.example.com/api/v1" }`
# before the app bundle; that value takes precedence over this env var.
# NEXT_PUBLIC_API_BASE_URL is accepted as an alias for the same setting.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SFTP_HOST=127.0.0.1
NEXT_PUBLIC_SFTP_PORT=2222
NEXT_PUBLIC_SFTP_USER=game
