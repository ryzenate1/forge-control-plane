# Canonical dev-stack ports — single source of truth.
# Sourced by scripts/dev/*.sh, scripts/*.sh wrappers and native.sh.
# Runtime overrides may be exported before sourcing; defaults below apply
# only when the variable is unset. The running stack records its effective
# ports to .dev-data/ports.env on start for status/diagnose discovery.
DB_PORT="${DB_PORT:-5432}"
REDIS_PORT="${REDIS_PORT:-6379}"
API_PORT="${API_PORT:-8080}"
DAEMON_PORT="${DAEMON_PORT:-9090}"
DAEMON_SFTP_PORT="${DAEMON_SFTP_PORT:-2022}"
FRONTEND_PORT="${FRONTEND_PORT:-3000}"
# Observability (host-mapped in compose.production.yml):
PROM_PORT="${PROM_PORT:-9091}"
ALERTMANAGER_PORT="${ALERTMANAGER_PORT:-9093}"
GRAFANA_PORT="${GRAFANA_PORT:-3001}"
