{
  "name": "@forge/game-templates",
  "private": true,
  "version": "0.1.0",
  "description": "Game server template catalog for Forge \u2014 one-click deploy templates for Minecraft, Palworld, Valheim, Terraria, Enshrouded, Satisfactory, and more",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/validate-templates.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/shared-types": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "templates",
    "index.json",
    "template-schema.json"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
