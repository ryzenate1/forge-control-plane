{
  "name": "@forge/ui",
  "private": true,
  "version": "0.1.0",
  "description": "Shared React UI components for the Forge control plane",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
