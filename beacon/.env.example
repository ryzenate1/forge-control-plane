APP_ENV=development
DAEMON_ADDR=:9090
DAEMON_DATA_DIR=/srv/game-panel/servers
DAEMON_NODE_ID=22222222-2222-2222-2222-222222222222
# Panel-issued node credential in <id>.<secret> form. Generate locally in dev —
# never ship a literal. The daemon refuses to start with a dev token in production.
DAEMON_NODE_TOKEN=replace_with_panel_issued_id.secret
PANEL_API_URL=http://localhost:8080/api/v1
DAEMON_ALLOW_MOCK_RUNTIME=false
DAEMON_ALLOW_INSECURE_NO_AUTH=false
# Optional. Encrypts the SFTP host key at rest (>=16 bytes). When unset, Beacon
# auto-generates a stable per-install secret at <DAEMON_DATA_DIR>/.sftp/
# host-key-passphrase on first run, so no extra configuration is required.
DAEMON_SFTP_HOST_KEY_PASSPHRASE=
DAEMON_SFTP_ADDR=:2022
DAEMON_RATE_POWER_RPM=30
DAEMON_RATE_WEBSOCKET_RPM=60
DAEMON_RATE_FILES_RPM=120
DAEMON_RATE_DEFAULT_RPM=240
DAEMON_MAX_HEADER_BYTES=65536
